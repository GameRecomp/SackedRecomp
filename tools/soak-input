#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Random input for a soak run, as an RC_INPUT script (hle/frames.c).

    tools/soak-input PREFIX.input FROM TO [--seed N] [--area X0 Y0 X1 Y1] > soak.input

Copies the lines of PREFIX.input before frame FROM (how the run gets into the game), then from
frame FROM to TO a click every few frames at random places of the area (default the whole
1024x768 screen), now and then a right click, Escape or Enter (to close what a click opened). The
same seed gives the same script, so a failing run can be repeated.
"""
import argparse
import random
import sys


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("prefix")
    ap.add_argument("start", type=int)
    ap.add_argument("end", type=int)
    ap.add_argument("--seed", type=int, default=1)
    ap.add_argument("--area", type=int, nargs=4, default=[0, 0, 1023, 767])
    a = ap.parse_args()
    rnd = random.Random(a.seed)
    out = []
    for line in open(a.prefix, encoding="utf-8"):
        s = line.strip()
        if not s or s.startswith("#"):
            continue
        if int(s.split()[0]) < a.start:
            out.append(s)
    x0, y0, x1, y1 = a.area
    f = a.start
    while f < a.end:
        x, y = rnd.randint(x0, x1), rnd.randint(y0, y1)
        r = rnd.random()
        out.append(f"{f} move {x} {y}")
        if r < 0.08:
            out += [f"{f + 2} key 27", f"{f + 4} keyup 27"]
        elif r < 0.14:
            out += [f"{f + 2} key 13", f"{f + 4} keyup 13"]
        else:
            button = 2 if r < 0.22 else 1
            out += [f"{f + 2} down {button}", f"{f + 5} up {button}"]
        f += rnd.randint(12, 40)
    print("# SPDX-License-Identifier: MIT")
    print(f"# soak: random input from frame {a.start} to {a.end}, seed {a.seed}")
    print("\n".join(out))


if __name__ == "__main__":
    sys.exit(main())
